{
  "name": "TFG Fraud Detection GNN",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "containerEnv": {
    "HF_HOME": "${containerWorkspaceFolder}/.cache/huggingface",
    "KAGGLEHUB_CACHE": "${containerWorkspaceFolder}/.cache/kagglehub",
    "MLFLOW_TRACKING_URI": "sqlite:///${containerWorkspaceFolder}/outputs/mlflow/mlflow.db"
  },
  "remoteUser": "vscode"
}
